# Скопируйте в файл `.env` в корне проекта и подставьте значения.
# Файл `.env` не коммитьте (см. .gitignore).

# --- OpenAI (авто-теги по превью, /api/tags/auto) ---
OPENAI_API_KEY=
# Необязательно: кастомный API (прокси, Azure-совместимый и т.д.)
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
OPENAI_TAG_MODEL=gpt-4o-mini

# --- AI-описания моделей + семантический поиск ---
# Модель Vision для описания модели по превью (/api/describe).
OPENAI_DESCRIBE_MODEL=gpt-4o-mini
# Модель эмбеддингов и её размерность (должна совпадать с EMBED_DIM).
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# --- Порты, публикуемые docker-compose наружу (нестандартные, чтобы не конфликтовать) ---
APP_HOST_PORT=18080
QDRANT_HOST_PORT=16333
QDRANT_GRPC_HOST_PORT=16334

# --- Qdrant (векторная база для поиска похожих) ---
# В docker-compose host = qdrant. Локально без Docker — 127.0.0.1.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# Полный URL имеет приоритет над host/port (например для Qdrant Cloud).
# QDRANT_URL=
# QDRANT_API_KEY=
QDRANT_COLLECTION=models

# --- База данных каталога: sqlite (по умолчанию) или mysql ---
DB_CONNECTION=sqlite
# Для MySQL укажите DB_CONNECTION=mysql и параметры подключения:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=model_catalog
# DB_USERNAME=
# DB_PASSWORD=

# --- Хранилище файлов моделей: local (ФС) или s3 (облако) ---
STORAGE_BACKEND=local

# --- Пути и данные (для STORAGE_BACKEND=local) ---
# Путь к каталогу моделей при локальном запуске (без Docker).
# MODELS_DIR=
# Путь к каталогу моделей на ХОСТЕ для docker-compose (монтируется в /data/models).
# MODELS_HOST_DIR=./models
# DATA_DIR=
# PREVIEWS_DIR=
# SQLITE_PATH=
# Локальный кэш скачанных из S3 объектов (для рендера превью / распаковки zip).
# CACHE_DIR=

# --- S3 / S3-совместимое хранилище (для STORAGE_BACKEND=s3) ---
# Пусто = обычный AWS S3. Для MinIO/Yandex/Cloudflare R2 укажите endpoint_url.
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=models
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Префикс (папка) внутри бакета — каталог моделей. Пути в БД — относительно него.
# S3_PREFIX=catalog
# path (MinIO/большинство совместимых) или virtual (AWS).
# S3_ADDRESSING_STYLE=path

# --- API для внешних приложений ---
# JSON с группами запуска (фильтры тегов/путей + опциональный unit_main).
# LAUNCH_GROUPS_PATH=
# Абсолютные URL в ответах /api/launch-groups/.../models (если не передан ?base_url=).
# API_BASE_URL=http://127.0.0.1:8000

# --- Сканер каталога ---
# SCAN_INTERVAL_SEC=60
# Отключить встроенный сканер в сервисе app (если сканирует отдельный процесс).
# RUN_SCANNER=1

# --- Воркер обогащения БД (сервис worker: теги + AI-описания + эмбеддинги) ---
WORKER_INTERVAL_SEC=30
WORKER_TAG_BATCH=20
WORKER_DESCRIBE_BATCH=20
WORKER_DO_TAGS=1
WORKER_DO_DESCRIBE=1

# --- Превью ---
# PREVIEW_ENGINE=auto
# PREVIEW_BATCH_PER_CYCLE=500
# PREVIEW_SUBPROCESS_TIMEOUT_SEC=900
# PREVIEW_PIXEL_SIZE=384
# PREVIEW_SIMPLIFY_MAX_FACES=80000
# PREVIEW_SIMPLIFY_TARGET_FACES=28000
# PREVIEW_BROWSER_TIMEOUT_MS=240000
# PREVIEW_MAX_MEMORY_MB=10240
