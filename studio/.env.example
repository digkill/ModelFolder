# Скопируйте в studio/.env — не коммитьте секреты.

STUDIO_ADDR=:8080
STUDIO_DATABASE_URL=postgres://studio:studio@127.0.0.1:15433/studio?sslmode=disable
# Каталог моделей (семантический поиск)
CATALOG_URL=http://127.0.0.1:18080
# Публичный origin файлов каталога. Пусто = относительные /files/... (один хост с витриной).
CATALOG_PUBLIC_URL=
STUDIO_PUBLIC_URL=http://127.0.0.1:18081/app

# Оркестратор и геймдизайнер: auto берёт прямой Anthropic, затем Claude через Kie.
# STUDIO_ORCHESTRATOR=auto | anthropic-claude | claude-opus-5 | grok-4-6 | openai-gpt | xai-grok
STUDIO_ORCHESTRATOR=auto

# Прямые API
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
XAI_API_KEY=

# Агрегатор моделей https://kie.ai  (chat + image/video/audio)
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai/api/v1

# Генерация 3D-мешей
MESHY_API_KEY=
